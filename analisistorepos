<script>
    const baseCsvUrl = "https://docs.google.com/spreadsheets/d/e/2PACX-1vRSwk2BhmMriyZotR2gLYtOkHic0lM3-0efkhaKhJ7gxDyQyqbGF0noTp9RV9GQgEHWTeuSskT57sVI/pub?gid=1352769388&single=true&output=csv";
    
    let rawData = [];
    let columns = [];
    let trendChartInstance = null;
    let pdvChartInstance = null;
    let dataTableInstance = null;

    window.onload = () => {
        loadData();
    };

    function loadData() {
        const btn = document.getElementById('btnRefresh');
        btn.disabled = true;
        btn.innerHTML = '⏳ Caricamento in corso...';

        const fetchUrl = baseCsvUrl + "&_t=" + new Date().getTime();

        Papa.parse(fetchUrl, {
            download: true,
            header: true,
            skipEmptyLines: true,
            complete: function(results) {
                rawData = results.data;
                columns = results.meta.fields;
                autoGenerate();
                
                btn.disabled = false;
                btn.innerHTML = '🔄 Aggiorna Dati';
            },
            error: function(err) {
                alert("Errore nel download dal foglio Google. Verifica che il link CSV sia corretto. Dettaglio: " + err.message);
                btn.disabled = false;
                btn.innerHTML = '🔄 Riprova';
            }
        });
    }

    function autoGenerate() {
        if (!columns || columns.length === 0) return;

        let colData = columns[0];
        let colPdv = columns.length > 1 ? columns[1] : columns[0];
        let colIncasso = columns.length > 2 ? columns[2] : columns[0];

        columns.forEach(col => {
            const lower = col.toLowerCase();
            if (lower.includes('data') || lower.includes('date')) colData = col;
            if (lower.includes('punto') || lower.includes('pdv') || lower.includes('negozio')) colPdv = col;
            if (lower.includes('incasso') || lower.includes('totale') || lower.includes('prezzo') || lower.includes('importo') || lower.includes('valore')) colIncasso = col;
        });

        generateDashboard(colData, colPdv, colIncasso);
    }

    function generateDashboard(colData, colPdv, colIncasso) {
        document.getElementById('dashboardSection').classList.remove('d-none');

        let totalIncasso = 0;
        let trendData = {};
        let pdvData = {};

        rawData.forEach(row => {
            let rawVal = String(row[colIncasso] || '0');
            rawVal = rawVal.replace('€', '').trim();
            if(rawVal.includes(',') && rawVal.includes('.')) {
                 rawVal = rawVal.replace(/\./g, '').replace(',', '.');
            } else if (rawVal.includes(',')) {
                 rawVal = rawVal.replace(',', '.');
            }
            let incassoVal = parseFloat(rawVal);
            if (isNaN(incassoVal)) incassoVal = 0;
            
            totalIncasso += incassoVal;

            let dateVal = row[colData] ? String(row[colData]).trim() : 'Sconosciuta';
            if (!trendData[dateVal]) trendData[dateVal] = 0;
            trendData[dateVal] += incassoVal;

            let pdvVal = row[colPdv] ? String(row[colPdv]).trim() : 'Sconosciuto';
            if (!pdvData[pdvVal]) pdvData[pdvVal] = 0;
            pdvData[pdvVal] += incassoVal;
        });

        document.getElementById('kpiTotale').textContent = '€ ' + totalIncasso.toLocaleString('it-IT', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        document.getElementById('kpiTransazioni').textContent = rawData.length.toLocaleString('it-IT');

        const trendLabels = Object.keys(trendData).sort((a,b) => new Date(a.split('/').reverse().join('-')) - new Date(b.split('/').reverse().join('-')));
        const trendValues = trendLabels.map(l => trendData[l]);
        
        if (trendChartInstance) trendChartInstance.destroy();
        const ctxTrend = document.getElementById('trendChart').getContext('2d');
        trendChartInstance = new Chart(ctxTrend, {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [{
                    label: 'Incasso Giornaliero (€)',
                    data: trendValues,
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, 0.15)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.3,
                    pointRadius: 3
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });

        const pdvLabels = Object.keys(pdvData).sort((a, b) => pdvData[b] - pdvData[a]);
        const pdvValues = pdvLabels.map(l => pdvData[l]);

        if (pdvChartInstance) pdvChartInstance.destroy();
        const ctxPdv = document.getElementById('pdvChart').getContext('2d');
        pdvChartInstance = new Chart(ctxPdv, {
            type: 'bar',
            data: {
                labels: pdvLabels,
                datasets: [{
                    label: 'Incasso per Punto Vendita (€)',
                    data: pdvValues,
                    backgroundColor: '#198754',
                    borderRadius: 4
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });

        if (dataTableInstance) {
            dataTableInstance.destroy();
            document.getElementById('dtHead').innerHTML = '';
            document.getElementById('dtBody').innerHTML = '';
        }

        let trHead = document.createElement('tr');
        columns.forEach(col => {
            let th = document.createElement('th');
            th.textContent = col;
            trHead.appendChild(th);
        });
        document.getElementById('dtHead').appendChild(trHead);

        rawData.forEach(row => {
